{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteAnywhere",
  "version": "1.9.2",
  "identifier": "com.lq1123.noteanywhere",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NoteAnywhere",
        "width": 880,
        "height": 580,
        "minWidth": 620,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
