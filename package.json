{
  "name": "note-anywhere",
  "productName": "NoteAnywhere",
  "version": "1.7.3",
  "description": "Alt+Q 呼出的灵感速记 — 顶置书写卡，收起即保存为 Markdown",
  "main": "main.js",
  "author": "noteanywhere",
  "license": "MIT",
  "scripts": {
    "bundle": "esbuild renderer/src/app.js --bundle --outfile=renderer/app.bundle.js --format=iife --target=chrome130 --minify",
    "start": "npm run bundle && electron .",
    "smoke": "npm run bundle && electron tools/smoke-bootstrap.js --smoke",
    "diag": "npm run bundle && electron tools/smoke-bootstrap.js --smoke --diag",
    "test:tables": "node --test tools/table-gate.test.cjs && npm run bundle && electron tools/table-regression.js",
    "icon": "node tools/gen-icon.js",
    "dist": "npm run bundle && electron-builder"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "codemirror": "^6.0.0",
    "esbuild": "^0.25.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.noteanywhere.app",
    "productName": "NoteAnywhere",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "NoteAnywhere-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NoteAnywhere-Portable.${ext}"
    }
  }
}
